# Copy to .env for local use. Never commit the real values.
# Without META_ACCESS_TOKEN the app runs in sample mode (invented data, clearly labelled).
META_ACCESS_TOKEN=
# Check Meta's current Graph API version before deploying.
META_API_VERSION=v23.0
# Optional: if set, visitors must type this code to search (keeps the tool private).
ACCESS_CODE=
# Optional: searches per minute per visitor (default 20).
RATE_LIMIT_PER_MIN=20
